# --- Rust Build Artifacts (HUGE folders) ---
/target/
**/*.rs.bk

# --- ESP-IDF & Build Tools ---
# These are downloaded tools and local build configurations
/.embuild/
/.esp-idf/
/esp-idf/

# --- ESP32 Configuration Files ---
# sdkconfig is the generated config. We usually track 'sdkconfig.defaults' instead.
sdkconfig
sdkconfig.old
sdkconfig.ci

# --- Visual Studio Code & Editors ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Flash Artifacts ---
# If you manually generated binaries
*.bin
*.elf